# PostgreSQL connection (Plaid-synced public.* + read-write app.*)
DATABASE_URL=postgresql+asyncpg://finance:CHANGE_ME@localhost:5432/finance

# Timezone (matches upstream finance-db)
TZ=America/Los_Angeles
APP_TIMEZONE=America/Los_Angeles

# Optional OpenAI-compatible AI Gateway (e.g. CLIProxyAPI) or direct Google Gemini API
AI_API_BASE_URL=http://host.docker.internal:8317/v1
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash-high

# Optional Bearer Token for /mcp endpoint
MCP_BEARER_TOKEN=

# Host binding & deployment target (used by docker-compose.yml and scripts/deploy.sh)
BIND_HOST=127.0.0.1
HOST=0.0.0.0
PORT=8000
REMOTE_HOST=your-linux-server
REMOTE_DIR=/opt/personal-finance-dashboard
